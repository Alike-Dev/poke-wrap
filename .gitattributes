# Normalize line endings in the repository.
# Force LF everywhere, regardless of the contributor's OS.
* text=auto eol=lf

# Windows-specific scripts (if you add any later) keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: do not touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary